# College Corridor — Clean URLs (.html Extension Removal & Canonical Routing)
RewriteEngine On
RewriteBase /

# Redirect external requests with .html to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*([^.]+)\.html\ HTTP/
RewriteRule ^([^/]+/)*([^.]+)\.html$ /$1$2 [R=301,L]

# Internally rewrite clean URLs to corresponding .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
